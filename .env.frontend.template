# Frontend configuration.  cp .env.frontend.template .env.frontend

# Django API, reached from inside the docker network (server components).
API_URL=http://api:8000

# Public base URL of the Next.js app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev authentication ------------------------------------------------------
# The login UI is currently removed, but the Django API still requires a JWT.
# The server signs in as this account on the frontend's behalf and caches the
# token; the credentials never reach the browser.
#
# Must match a real Django user — create one with:  make superuser
DEV_USERNAME=ragtester
DEV_PASSWORD=
