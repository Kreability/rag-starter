# Frontend configuration.  cp .env.frontend.template .env.frontend

# Django API, reached from inside the docker network (server components).
API_URL=http://api:8000

# Public base URL of the Next.js app itself.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Session -----------------------------------------------------------------
# Signs the session cookie. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/api/auth

# --- Dev mode ----------------------------------------------------------------
# Leave DEV_MODE unset for normal operation: visitors register and sign in, and
# each account sees only its own documents.
#
# Set DEV_MODE=true to skip the login screen entirely while trying the template
# out locally. The server then signs in as the single DEV_USERNAME account on
# every visitor's behalf, so EVERYONE SHARES ONE KNOWLEDGE BASE. The app refuses
# to start if DEV_MODE=true with NODE_ENV=production.
#
# DEV_USERNAME must match a real Django user — create one with:  make superuser
DEV_MODE=
DEV_USERNAME=ragtester
DEV_PASSWORD=
