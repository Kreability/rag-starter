###############################################################################
# Backend configuration.  cp .env.backend.template .env.backend
#
# Minimum to get running: set SECRET_KEY, LLM_API_KEY and EMBEDDER_API_KEY.
# Everything else has a working default for the docker compose stack.
###############################################################################

# --- Django ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
SECRET_KEY=
# 1 = development (verbose errors, no HTTPS enforcement). Never 1 in production.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
DATABASE_HOST=db
DATABASE_NAME=db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-password

# --- CORS / CSRF -------------------------------------------------------------
# Explicit origins only; a credentialed API must never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Rate limiting -----------------------------------------------------------
# Every chat call costs tokens; every upload costs embeddings.
THROTTLE_USER=1000/hour
THROTTLE_ANON=60/hour
THROTTLE_CHAT=120/hour
THROTTLE_DOCUMENTS=200/hour

###############################################################################
# LLM  — any OpenAI-compatible endpoint
#
#   OpenAI      LLM_BASE_URL=            (leave empty)      LLM_MODEL=gpt-4o-mini
#   Ollama      LLM_BASE_URL=http://ollama:11434/v1         LLM_MODEL=llama3.1
#   vLLM/STACKIT LLM_BASE_URL=https://api.openai-compat.example/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
###############################################################################
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# --- Embeddings --------------------------------------------------------------
# EMBEDDER_DIMENSIONS must match the model. Changing it requires re-indexing:
#   text-embedding-3-small = 1536,  text-embedding-3-large = 3072
#   nomic-embed-text (Ollama) = 768
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=
EMBEDDER_DIMENSIONS=1536
EMBEDDER_BATCH_SIZE=64

# Sparse vectors give Qdrant true hybrid (semantic + keyword) search.
SPARSE_EMBEDDER_ENABLED=True
SPARSE_EMBEDDER_MODEL=Qdrant/bm25

# --- Vector database ---------------------------------------------------------
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION_NAME=rag
# HYBRID (dense+sparse) | DENSE | SPARSE
VECTOR_DB_RETRIEVAL_MODE=HYBRID

# --- Retrieval ---------------------------------------------------------------
# One budget per content type, then a global cap before reranking.
RETRIEVER_THRESHOLD=0.5
RETRIEVER_K_DOCUMENTS=10
RETRIEVER_TABLE_THRESHOLD=0.37
RETRIEVER_TABLE_K_DOCUMENTS=10
RETRIEVER_SUMMARY_THRESHOLD=0.5
RETRIEVER_SUMMARY_K_DOCUMENTS=10
RETRIEVER_IMAGE_THRESHOLD=0.5
RETRIEVER_IMAGE_K_DOCUMENTS=10
RETRIEVER_TOTAL_K_DOCUMENTS=10

# --- Reranking (CPU cross-encoder, no GPU needed) ----------------------------
RERANKER_ENABLED=True
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_K_DOCUMENTS=5
RERANKER_MIN_RELEVANCE_SCORE=0.001

# --- Chunking & summarisation ------------------------------------------------
CHUNKER_MAX_SIZE=1000
CHUNKER_OVERLAP=100
# Page summaries markedly improve recall on "what does this doc say about X",
# at the cost of one LLM call per page at ingest time.
SUMMARIZER_ENABLED=True
SUMMARIZER_MAXIMUM_INPUT_SIZE=8000
SUMMARIZER_MAXIMUM_CONCURRENCY=4

# --- Chat history ------------------------------------------------------------
CHAT_HISTORY_LIMIT=4
CHAT_HISTORY_REVERSE=True

# --- Ingestion ---------------------------------------------------------------
INGESTION_MAX_FILE_SIZE_MB=50
# Docling gives the best extraction (OCR, table structure) but pulls in torch.
# Enable the image extra first:  uv sync --extra docling
INGESTION_PREFER_DOCLING=False
INGESTION_SITEMAP_MAX_PAGES=200
INGESTION_ALLOWED_URL_SCHEMES=https,http

# --- Object storage (MinIO locally, any S3 in production) --------------------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
REDIS_URL=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=1800

###############################################################################
# Langfuse — LLM tracing, prompt management, cost tracking (optional)
#
#   Self-hosted:  docker compose --profile observability up   (localhost:3001)
#   Cloud:        LANGFUSE_HOST=https://cloud.langfuse.com
#
# Leave the keys empty to disable tracing entirely.
###############################################################################
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Only used to seed the self-hosted instance on first boot.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# --- Confluence ingestion (optional; needs: uv sync --extra confluence) ------
CONFLUENCE_TOKEN=
CONFLUENCE_VERIFY_SSL=True
