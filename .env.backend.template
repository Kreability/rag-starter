###############################################################################
# Backend configuration.  cp .env.backend.template .env.backend
#
# Minimum to get running: set SECRET_KEY, LLM_API_KEY and EMBEDDER_API_KEY.
# Everything else has a working default for the docker compose stack.
###############################################################################

# --- Django ------------------------------------------------------------------
# Generate with: openssl rand -base64 48
SECRET_KEY=
# 1 = development (verbose errors, no HTTPS enforcement). Never 1 in production.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
DATABASE_HOST=db
DATABASE_NAME=db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-password

# --- CORS / CSRF -------------------------------------------------------------
# Explicit origins only; a credentialed API must never use a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Rate limiting -----------------------------------------------------------
# Every chat call costs tokens; every upload costs embeddings.
THROTTLE_USER=1000/hour
THROTTLE_ANON=60/hour
THROTTLE_CHAT=120/hour
THROTTLE_DOCUMENTS=1000/hour
THROTTLE_AUDIT=60/hour
THROTTLE_EVALUATION=30/hour

###############################################################################
# LLM  — any OpenAI-compatible endpoint
#
#   OpenAI      LLM_BASE_URL=            (leave empty)      LLM_MODEL=gpt-4o-mini
#   Ollama      LLM_BASE_URL=http://ollama:11434/v1         LLM_MODEL=llama3.1
#   vLLM/STACKIT LLM_BASE_URL=https://api.openai-compat.example/v1
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#   LAN Ollama   LLM_BASE_URL=http://192.168.1.38:11434/v1  LLM_MODEL=qwen2.5:3b
###############################################################################
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# --- Embeddings --------------------------------------------------------------
# EMBEDDER_DIMENSIONS must match the model. Changing it requires re-indexing:
#   text-embedding-3-small = 1536,  text-embedding-3-large = 3072
#   BAAI/bge-small-en-v1.5 (FastEmbed, no API key) = 384
#   nomic-embed-text (Ollama) = 768
EMBEDDER_PROVIDER=local
EMBEDDER_MODEL=BAAI/bge-small-en-v1.5
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=
EMBEDDER_DIMENSIONS=384
EMBEDDER_BATCH_SIZE=64

# Sparse vectors give Qdrant true hybrid (semantic + keyword) search.
SPARSE_EMBEDDER_ENABLED=True
SPARSE_EMBEDDER_MODEL=Qdrant/bm25

# --- Ingestion quality -------------------------------------------------------
# Below this many extracted text/table characters, try the next extractor.
QUALITY_MIN_USABLE_CHARS=50

# --- Vector database ---------------------------------------------------------
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION_NAME=rag
# HYBRID (dense+sparse) | DENSE | SPARSE
VECTOR_DB_RETRIEVAL_MODE=HYBRID

# --- Retrieval ---------------------------------------------------------------
# One budget per content type, then a global cap before reranking.
RETRIEVER_THRESHOLD=0.5
RETRIEVER_K_DOCUMENTS=10
RETRIEVER_TABLE_THRESHOLD=0.37
RETRIEVER_TABLE_K_DOCUMENTS=10
RETRIEVER_SUMMARY_THRESHOLD=0.5
RETRIEVER_SUMMARY_K_DOCUMENTS=10
RETRIEVER_IMAGE_THRESHOLD=0.5
RETRIEVER_IMAGE_K_DOCUMENTS=10
RETRIEVER_TOTAL_K_DOCUMENTS=10

# --- Reranking (CPU cross-encoder, no GPU needed) ----------------------------
RERANKER_ENABLED=True
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_K_DOCUMENTS=5
# Anchor bar: even the top hit must clear this or the query matched only noise.
# FlashRank sigmoid scores are small — keep this at 1e-4 for ms-marco.
RERANKER_MIN_RELEVANCE_SCORE=0.000001
# Tail cutoff relative to the top hit; keeps weak-but-real matches, cuts noise.
RERANKER_MIN_RELEVANCE_RATIO=0.05

# --- Chunking & summarisation ------------------------------------------------
CHUNKER_MAX_SIZE=1000
CHUNKER_OVERLAP=100
# Page summaries markedly improve recall on "what does this doc say about X",
# at the cost of one LLM call per page at ingest time.
SUMMARIZER_ENABLED=True
SUMMARIZER_MAXIMUM_INPUT_SIZE=8000
SUMMARIZER_MAXIMUM_CONCURRENCY=4

# --- Chat history ------------------------------------------------------------
CHAT_HISTORY_LIMIT=4
CHAT_HISTORY_REVERSE=True

# --- Small talk / greetings --------------------------------------------------
# Pure greetings ("hey", "hi", "thanks", "what can you do") skip retrieval and
# are answered conversationally instead of hitting the vector DB or producing
# a hallucinated "about the context" reply.
#   SMALL_TALK_ENABLED=false -> every message goes through retrieval.
#   SMALL_TALK_REPLY_MODE=template -> static offline reply, zero LLM calls.
#   SMALL_TALK_REPLY_MODE=llm      -> short language-aware reply via the model.
#   SMALL_TALK_PATTERNS             -> comma-separated regexes (full match).
SMALL_TALK_ENABLED=True
SMALL_TALK_REPLY_MODE=template
SMALL_TALK_RESPONSE=Hi there! How can I help you today?

# --- User-facing messages ----------------------------------------------------
# Shown when nothing relevant is found in the user's documents.
ERROR_MESSAGES_NO_DOCUMENTS_MESSAGE=I couldn't find anything in the knowledge base that answers this.
# Shown when retrieval found matches but the model itself failed (unreachable
# provider, timeout, crash). Never masked as the no-match message above.
ERROR_MESSAGES_GENERATION_FAILED_MESSAGE=I found relevant information but couldn't generate an answer right now. Please try again.

# --- Ingestion ---------------------------------------------------------------
INGESTION_MAX_FILE_SIZE_MB=50
# Docling gives the best extraction (OCR, table structure) but pulls in torch.
# The compose worker enables this automatically; the slim API can remain false.
INGESTION_PREFER_DOCLING=False
INGESTION_SITEMAP_MAX_PAGES=200
INGESTION_ALLOWED_URL_SCHEMES=https,http

# --- Object storage (MinIO locally, any S3 in production) --------------------
S3_ENDPOINT=http://minio:9000
# Host the browser uses to fetch pre-signed document links. In Docker Compose
# the backend talks to `minio` on the internal network, but the browser reaches
# the same bucket through the host-published port. Set to your own domain in
# production (must be reachable by both the API and the end user's browser).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
REDIS_URL=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=1800

###############################################################################
# Langfuse — LLM tracing, prompt management, cost tracking (optional)
#
#   Self-hosted:  docker compose --profile observability up   (localhost:3001)
#   Cloud:        LANGFUSE_HOST=https://cloud.langfuse.com
#
# Self-hosted is v4 (docker.langfuse.com/langfuse/langfuse:4), which needs
# ClickHouse/Redis/MinIO of its own — see the langfuse-* services in
# docker-compose.yaml. v2's server has no OTLP endpoint, which the
# langfuse-python client this project uses (v3+) requires.
#
# Leave LANGFUSE_PUBLIC_KEY/LANGFUSE_SECRET_KEY empty to disable tracing.
#
# Format matters: Langfuse's own keys look like pk-lf-<uuid> / sk-lf-<uuid>
# (hyphens, "lf" in the middle). A self-invented format — e.g. lf_pk_<hex> —
# passes every startup check silently (the key gets seeded, shows correctly
# in the Langfuse UI, "looks right") but every auth call then fails with a
# generic 401 "Invalid credentials. Confirm that you've configured the
# correct host." that has nothing to do with the actual cause. Safest path:
# leave these blank, let the container seed with generated ones, and copy
# the real values back out via Project Settings > API Keys in the UI
# (localhost:3001) after first boot.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Only used to seed the self-hosted instance on first boot.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Required by v4 (encrypts stored API keys/secrets). Generate with:
#   openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_INIT_ORG_ID is the switch that turns on the whole seed step below —
# without it, v4 silently skips seeding and the project/keys never exist,
# so every trace export 401s even though the rest of the config looks right.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
# Must be a real-looking email — Langfuse's own schema rejects addresses
# without a standard TLD (e.g. "admin@localhost" fails validation).
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Credentials for langfuse's own ClickHouse/Redis/MinIO (self-hosted only —
# unrelated to this app's own db/redis/minio services above).
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=

# --- Confluence ingestion (optional; needs: uv sync --extra confluence) ------
CONFLUENCE_TOKEN=
CONFLUENCE_VERIFY_SSL=True
