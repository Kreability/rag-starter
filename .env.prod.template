###############################################################################
# Production configuration.  cp .env.prod.template .env.prod
#
# This single file feeds api, worker, beat, web and the data services, so it
# holds both backend and frontend variables (dev splits them across
# .env.backend and .env.frontend; production keeps one file to fill in).
#
# NEVER commit .env.prod. Every secret below must be generated, not guessed:
#
#     openssl rand -base64 48
#
# Anything left empty that is marked REQUIRED will stop the stack from
# starting — that is deliberate, an accidental default in production is worse
# than a failed boot.
###############################################################################

# --- Domain & TLS ------------------------------------------------------------
# REQUIRED. The hostname Caddy serves and requests a certificate for.
# Use `localhost` to test the production stack locally (Caddy then issues an
# internal self-signed cert instead of talking to Let's Encrypt).
DOMAIN=
# Certificate-expiry notifications are off by default. To receive them, add an
# `email you@example.com` global block at the top of the Caddyfile (it cannot
# be wired to an env var here: Caddy rejects a bare `email` with no argument,
# which is what an empty value would produce).

# --- Django ------------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 48
SECRET_KEY=
# Must stay 0. Setting this to 1 in production leaks tracebacks, disables HTTPS
# enforcement, and turns off secure cookies.
DEBUG=0
# REQUIRED. Comma-separated. Include your domain and the internal service name
# `api` (the healthcheck and the frontend's server components use it).
# Example: rag.example.com,api
ALLOWED_HOSTS=
LOG_LEVEL=INFO
RAG_LOG_LEVEL=INFO

# --- CORS / CSRF -------------------------------------------------------------
# REQUIRED. Full origins including scheme. HTTPS only in production, and never
# a wildcard: this API is credentialed.
# Example: https://rag.example.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Database ----------------------------------------------------------------
DATABASE_HOST=db
DATABASE_NAME=db
DATABASE_USER=postgres
# REQUIRED. Generate with: openssl rand -base64 36
# Postgres is not published to the host, but this is still the credential a
# compromised container would use.
DATABASE_PASSWORD=

# --- Vector database ---------------------------------------------------------
VECTOR_DB_URL=http://qdrant:6333
# REQUIRED. Generate with: openssl rand -base64 36
# Unlike the dev stack (where the Qdrant API key line is commented out), the
# production compose file always passes this to Qdrant as
# QDRANT__SERVICE__API_KEY. Note: an *empty* value still forces auth and would
# reject every request, which is why this must be set rather than blank.
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION_NAME=rag
VECTOR_DB_RETRIEVAL_MODE=HYBRID

# --- Object storage ----------------------------------------------------------
S3_ENDPOINT=http://minio:9000
# REQUIRED. Do NOT use minioadmin/minioadmin — that default is the first thing
# any scanner tries. Generate with: openssl rand -base64 24
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rag-documents
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# --- Celery / Redis ----------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
REDIS_URL=redis://redis:6379/1
CELERY_TASK_TIME_LIMIT=1800
# Ingestion is CPU-bound when FlashRank/FastEmbed run locally. Start at 2 and
# raise only if the host has cores to spare (see DEPLOYMENT.md, Scaling).
CELERY_CONCURRENCY=2
# Recycle workers periodically so a slow leak in a parser cannot grow forever.
CELERY_MAX_TASKS_PER_CHILD=50

# --- Gunicorn ----------------------------------------------------------------
# Rule of thumb: (2 x CPU cores) + 1, capped by available RAM.
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# --- Auth --------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Rate limiting -----------------------------------------------------------
# Every chat call costs tokens; every upload costs embeddings. Tighten these
# before exposing the API to untrusted users.
THROTTLE_USER=1000/hour
THROTTLE_ANON=60/hour
THROTTLE_CHAT=120/hour
THROTTLE_DOCUMENTS=200/hour

###############################################################################
# LLM — any OpenAI-compatible endpoint
###############################################################################
# REQUIRED unless you point LLM_BASE_URL at a local model.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# --- Embeddings --------------------------------------------------------------
# EMBEDDER_DIMENSIONS must match the model. Changing it later requires a full
# re-index: text-embedding-3-small=1536, -3-large=3072, nomic-embed-text=768.
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=
EMBEDDER_DIMENSIONS=1536
EMBEDDER_BATCH_SIZE=64

SPARSE_EMBEDDER_ENABLED=True
SPARSE_EMBEDDER_MODEL=Qdrant/bm25

# --- Retrieval ---------------------------------------------------------------
RETRIEVER_THRESHOLD=0.5
RETRIEVER_K_DOCUMENTS=10
RETRIEVER_TABLE_THRESHOLD=0.37
RETRIEVER_TABLE_K_DOCUMENTS=10
RETRIEVER_SUMMARY_THRESHOLD=0.5
RETRIEVER_SUMMARY_K_DOCUMENTS=10
RETRIEVER_IMAGE_THRESHOLD=0.5
RETRIEVER_IMAGE_K_DOCUMENTS=10
RETRIEVER_TOTAL_K_DOCUMENTS=10

# --- Reranking ---------------------------------------------------------------
RERANKER_ENABLED=True
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_K_DOCUMENTS=5
RERANKER_MIN_RELEVANCE_SCORE=0.001

# --- Chunking & summarisation ------------------------------------------------
CHUNKER_MAX_SIZE=1000
CHUNKER_OVERLAP=100
SUMMARIZER_ENABLED=True
SUMMARIZER_MAXIMUM_INPUT_SIZE=8000
SUMMARIZER_MAXIMUM_CONCURRENCY=4

# --- Chat history ------------------------------------------------------------
CHAT_HISTORY_LIMIT=4
CHAT_HISTORY_REVERSE=True

# --- Ingestion ---------------------------------------------------------------
INGESTION_MAX_FILE_SIZE_MB=50
INGESTION_PREFER_DOCLING=False
INGESTION_SITEMAP_MAX_PAGES=200
# Dropping `http` here is a cheap SSRF reduction if you only ingest public URLs.
INGESTION_ALLOWED_URL_SCHEMES=https

###############################################################################
# Frontend (Next.js)
###############################################################################
# Internal address of the Django API — server components call this over the
# compose network, so it stays http:// and does not go through Caddy.
API_URL=http://api:8000
# REQUIRED. Public HTTPS URL of the app. Example: https://rag.example.com
NEXT_PUBLIC_APP_URL=
# REQUIRED. Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=
# REQUIRED. Same value as NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL=

# The dev stack signs in as a seeded account via DEV_USERNAME/DEV_PASSWORD.
# Leave both unset in production: `init_rag` skips seeding without DEV_PASSWORD,
# and real users should authenticate as themselves.
# DEV_USERNAME=
# DEV_PASSWORD=

###############################################################################
# Langfuse tracing (optional) — leave keys empty to disable entirely.
###############################################################################
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Confluence ingestion (optional) -----------------------------------------
CONFLUENCE_TOKEN=
CONFLUENCE_VERIFY_SSL=True
